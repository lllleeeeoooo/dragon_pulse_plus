# ==============================================================================
#                      dragon_pulse_plus 全局配置文件 (.env)
# ==============================================================================
# 说明：
# 1. 使用前请将本文件复制重命名为 `.env` (同级目录下)
# 2. 系统启动时会自动读取 `.env` 中的配置参数覆盖默认设置
# 3. 布尔类型值填写 `true` 或 `false` (不区分大小写)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM 大模型配置 (用于盘后复盘、盘前简报、竞价观察与异动润色)
# ------------------------------------------------------------------------------

# 【必须设置】大模型 API 密钥
# 设置说明：填入您在 DeepSeek、OpenAI、Moonshot 或聚合服务商处申请的 API Key
# 示例：sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_KEY=sk-6522b9d51aa64057897c5626699b75f1

# 【必须设置】大模型 API 请求 Base URL 地址
# 设置说明：兼容 OpenAI 协议接口 endpoint。
# 常用设置：
#   - DeepSeek 官方: https://api.deepseek.com/v1
#   - OpenAI 官方: https://api.openai.com/v1
#   - Kimi (Moonshot): https://api.moonshot.cn/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 【必须设置】使用的模型名称
# 设置说明：填入对应 API 服务商支持的模型 ID
# 常用设置：
#   - DeepSeek V3/R1: deepseek-chat 或 deepseek-reasoner
#   - OpenAI: gpt-4o 或 gpt-4o-mini
#   - Claude: claude-3-5-sonnet-20241022
LLM_MODEL=deepseek-chat

# 【可选配置】LLM 生成随机性温度 (Temperature)
# 设置说明：浮点数，范围 0.0 ~ 1.0。值越低回答越严谨确定，值越高越具创造性。
# 推荐设置：短线策略与量化复盘建议设为 0.1 ~ 0.3 (默认 0.3)
LLM_TEMPERATURE=0.3

# 【可选配置】LLM API 请求超时时间 (单位：秒)
# 设置说明：如果大模型生成较慢，可适当调大该值，防止超时抛错 (默认 60 秒)
LLM_TIMEOUT=60

# 【可选配置】LLM 请求失败自动重试次数
# 设置说明：网络波动导致请求失败时的自动重试次数 (默认 3 次)
LLM_MAX_RETRIES=3


# ------------------------------------------------------------------------------
# 2. Bark 消息推送配置 (用于将复盘、竞价指令与盘中异动实时发送到手机)
# ------------------------------------------------------------------------------

# 【可选配置】Bark 消息推送 Device Key
# 设置说明：iPhone 打开 Bark App，连接后顶部显示的一串 Key。如果留空或填默认值则禁用推送。
# 示例：bX8aXXXXXXxxxxxx
BARK_TOKEN=QnW8Cbmg6HCsdoGc7i6r5c

# 【可选配置】Bark 服务器 Base URL
# 设置说明：如果使用官方服务器填 https://api.day.app 即可；若自建自建 Bark 服务请填私有地址
BARK_SERVER_URL=https://api.day.app

# 【可选配置】Bark 消息通知分组名称
# 设置说明：手机通知中心显示的通知分组名称 (默认：DragonPulse)
BARK_GROUP=DragonPulse

# 【可选配置】Bark 提示音名称
# 设置说明：推送时的手机响铃声音。可选值如：minuet, glass, alarm, chime, bell 等 (默认：minuet)
BARK_SOUND=minuet

# 【可选配置】是否启用 Bark 推送开关
# 设置说明：true = 启用推送；false = 禁用推送，仅在控制台打印日志 (默认：true)
BARK_ENABLED=true


# ------------------------------------------------------------------------------
# 3. 盘中 15 秒实时轮询监控配置
# ------------------------------------------------------------------------------

# 【核心参数】盘中实时行情快照轮询间隔 (单位：秒)
# 设置说明：交易时间内每隔多少秒抓取一次全市场快照。
# 推荐设置：15 秒（平衡接口防封与短线时效性，不要设低于 5 秒）
MONITOR_INTERVAL_SECONDS=15

# 【核心参数】点火异动 - 成交量放大倍数门槛
# 设置说明：当某股票量比（或成交量相比过去5日均值）达到该倍数时，触发点火预警 (默认：3.0，即放大3倍)
VOL_BURST_THRESHOLD=3.0

# 【核心参数】点火异动 - 股价单次突增涨幅门槛 (%)
# 设置说明：当股价瞬间突增涨幅达到该百分比时，触发点火预警 (默认：3.0，即上涨 3%)
PRICE_BURST_THRESHOLD=3.0

# 【可选配置】AkShare 数据抓取失败时的最大重试次数
# 设置说明：防止网络波动导致数据异常 (默认：3 次)
FETCH_RETRY_COUNT=3

# 【可选配置】AkShare 数据抓取重试延迟 (单位：秒)
# 设置说明：每次重试之间的间隔秒数 (默认：2.0 秒)
FETCH_RETRY_DELAY=2.0


# ------------------------------------------------------------------------------
# 4. 股票过滤配置 (源头剔除科创板、北交所及 ST 股)
# ------------------------------------------------------------------------------

# 【推荐开启】是否排除科创板股票 (代码 688 开头)
# 设置说明：true = 剔除科创板；false = 保留科创板 (默认：true)
EXCLUDE_STAR_MARKET=true

# 【推荐开启】是否排除北交所股票 (代码 8开头/43/83/87/920 等)
# 设置说明：true = 剔除北交所；false = 保留北交所 (默认：true)
EXCLUDE_BSE=true

# 【推荐开启】是否排除 ST 及 *ST 风险警示股票
# 设置说明：true = 剔除所有带有 ST 标识的股票；false = 保留 ST 股 (默认：true)
EXCLUDE_ST=true


# ------------------------------------------------------------------------------
# 5. 交易所异常波动监管红线与异动胆量风控配置
# ------------------------------------------------------------------------------

# 【推荐开启】交易所监管异动监控总开关
# 设置说明：true = 自动计算 3日偏离度、10日严重异动及资金突破胆量；false = 关闭监管监控 (默认：true)
REGULATORY_MONITOR_ENABLED=true

# 【官方规则】主板 3 日累计偏离度异动红线 (%)
# 设置说明：主板股票 3 个交易日内涨幅偏离度达到该值时，官方发布《异动公告》(默认：20.0%)
MAIN_BOARD_3D_DEV_LIMIT=20.0

# 【官方规则】创业板 3 日累计偏离度异动红线 (%)
# 设置说明：创业板股票 3 个交易日内涨幅偏离度达到该值时，官方发布《异动公告》(默认：30.0%)
GEM_3D_DEV_LIMIT=30.0

# 【官方规则】10 日严重异常波动累计偏离度红线 (%)
# 设置说明：连续 10 个交易日偏离度达到该值，触发《严重异常波动》及停牌风险 (默认：100.0%)
REGULATORY_10D_LIMIT=100.0

# 【官方规则】10 日内触发异动次数上限
# 设置说明：连续 10 个交易日内触发异常波动的次数达到该值，直接触发严重异动 (默认：4 次)
MAX_YIDONG_COUNT_10D=4


# ------------------------------------------------------------------------------
# 6. 量化战法与核心中军池参数配置
# ------------------------------------------------------------------------------

# 【动态中军】板块内选取的成交额 Top N 排名门槛
# 设置说明：筛选板块内成交额前 N 名的标的作为中军候选 (默认：前 3 名)
CORE_POOL_TOP_AMOUNT=3

# 【动态中军】板块内选取的总市值 Top N 排名门槛
# 设置说明：筛选板块内总市值前 N 名的标的作为中军候选 (默认：前 5 名)
CORE_POOL_TOP_MARKET_CAP=5

# 【动态中军】中军走势与板块指数皮尔逊相关系数 (Correlation/Beta) 门槛
# 设置说明：范围 0.0 ~ 1.0。值越大代表股票走势与板块指数越同频，低于该值被剔除 (默认：0.8)
CORE_POOL_MIN_BETA=0.8

# 【动态中军】中军日成交额最低门槛 (单位：亿元)
# 设置说明：中军必须是大容量流动性标的，日成交额不得低于该值 (默认：20.0 亿元)
CORE_POOL_MIN_AMOUNT=20.0

# 【二波战法】人气总龙头见顶后回撤最小比例
# 设置说明：前期人气龙头从最高点回撤达到该比例后开始关注二波止跌信号 (默认：0.30，即回撤 30%)
SECOND_WAVE_RETREAT_MIN=0.30

# 【二波战法】人气总龙头见顶后回撤最大比例
# 设置说明：回撤超过该比例说明题材彻底杀跌死掉，不再做二波 (默认：0.50，即回撤 50%)
SECOND_WAVE_RETREAT_MAX=0.50

# 【二波战法】追溯历史人气龙头的天数
# 设置说明：寻找过去多少个交易日内出现的连板总龙头 (默认：30 个交易日)
SECOND_WAVE_LOOKBACK_DAYS=30
