# ==============================================================================
#                      dragon_pulse_plus 全局配置文件 (.env)
# ==============================================================================
# 说明：
# 1. 使用前请将本文件复制重命名为 `.env` (同级目录下)
# 2. 系统启动时会自动读取 `.env` 中的配置参数覆盖默认设置
# 3. 布尔类型值填写 `true` 或 `false` (不区分大小写)
# ==============================================================================


# ------------------------------------------------------------------------------
# 0. 数据库配置
# ------------------------------------------------------------------------------

# 【可选配置】SQLite 生产数据库文件路径
# 设置说明：主数据库文件的存储路径（默认：dragon_pulse.db）
DB_PATH=dragon_pulse.db

# 【可选配置】SQLite 测试数据库文件路径
# 设置说明：测试运行使用的独立数据库文件路径（默认：dragon_pulse_test.db）
TEST_DB_PATH=dragon_pulse_test.db


# ------------------------------------------------------------------------------
# 1. LLM 大模型配置 (用于盘后复盘、盘前简报、竞价观察与异动润色)
# ------------------------------------------------------------------------------

# 【必须设置】大模型 API 密钥
# 设置说明：填入您在 DeepSeek、OpenAI、Moonshot 或聚合服务商处申请的 API Key
# 示例：sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_API_KEY=your_llm_api_key_here

# 【必须设置】大模型 API 请求 Base URL 地址
# 设置说明：兼容 OpenAI 协议接口 endpoint。
# 常用设置：
#   - DeepSeek 官方: https://api.deepseek.com/v1
#   - OpenAI 官方: https://api.openai.com/v1
#   - Kimi (Moonshot): https://api.moonshot.cn/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 【必须设置】使用的模型名称
# 设置说明：填入对应 API 服务商支持的模型 ID
# 常用设置：
#   - DeepSeek V3/R1: deepseek-chat 或 deepseek-reasoner
#   - OpenAI: gpt-4o 或 gpt-4o-mini
#   - Claude: claude-3-5-sonnet-20241022
LLM_MODEL=deepseek-chat

# 【可选配置】LLM 生成随机性温度 (Temperature)
# 设置说明：浮点数，范围 0.0 ~ 1.0。值越低回答越严谨确定，值越高越具创造性。
# 推荐设置：短线策略与量化复盘建议设为 0.1 ~ 0.3 (默认 0.3)
LLM_TEMPERATURE=0.3

# 【可选配置】LLM API 请求超时时间 (单位：秒)
# 设置说明：如果大模型生成较慢，可适当调大该值，防止超时抛错 (默认 180 秒，即 3 分钟)
LLM_TIMEOUT=180

# 【可选配置】LLM 请求失败自动重试次数
# 设置说明：网络波动导致请求失败时的自动重试次数 (默认 3 次)
LLM_MAX_RETRIES=3

# 【可选配置】备用 LLM API Base URL（主模型失败时自动切换）
# 设置说明：当主 LLM_API_KEY 或主 LLM_BASE_URL 请求连续失败后，自动降级切换到备用 endpoint。
#   - 留空则不启用备用模型容灾机制
#   - 填写后系统会自动在主/备之间切换，保障复盘与简报不断线
LLM_BACKUP_BASE_URL=

# 【可选配置】备用 LLM 模型名称
# 设置说明：备用 endpoint 使用的模型 ID，留空则使用与 LLM_MODEL 相同的模型名
# 示例：gpt-4o-mini（主用 deepseek-chat 时，备线用小而快的模型保证可用性）
LLM_BACKUP_MODEL=

# 【可选配置】备用 LLM API Key
# 设置说明：备用 endpoint 的 API Key，留空则复用主 LLM_API_KEY
LLM_BACKUP_API_KEY=


# ------------------------------------------------------------------------------
# 2. Bark 消息推送配置 (用于将复盘、竞价指令与盘中异动实时发送到手机)
# ------------------------------------------------------------------------------

# 【可选配置】Bark 消息推送 Device Key
# 设置说明：iPhone 打开 Bark App，连接后顶部显示的一串 Key。如果留空或填默认值则禁用推送。
# 示例：bX8aXXXXXXxxxxxx
BARK_TOKEN=your_bark_token_here

# 【可选配置】Bark 服务器 Base URL
# 设置说明：如果使用官方服务器填 https://api.day.app 即可；若自建自建 Bark 服务请填私有地址
BARK_SERVER_URL=https://api.day.app

# 【可选配置】Bark 消息通知分组名称
# 设置说明：手机通知中心显示的通知分组名称 (默认：DragonPulse)
BARK_GROUP=DragonPulse

# 【可选配置】Bark 提示音名称
# 设置说明：推送时的手机响铃声音。可选值如：minuet, glass, alarm, chime, bell 等 (默认：minuet)
BARK_SOUND=minuet

# 【可选配置】是否启用 Bark 推送开关
# 设置说明：true = 启用推送；false = 禁用推送，仅在控制台打印日志 (默认：true)
BARK_ENABLED=true


# ------------------------------------------------------------------------------
# 3. 盘中 15 秒实时轮询监控配置
# ------------------------------------------------------------------------------

# 【核心参数】盘中实时行情快照轮询间隔 (单位：秒)
# 设置说明：交易时间内每隔多少秒抓取一次全市场快照。
# 推荐设置：15 秒（平衡接口防封与短线时效性，不要设低于 5 秒）
# 【可选配置】涨停/炸板池缓存刷新间隔 (单位：秒)
# 设置说明：避免每轮询都调 API，默认 60 秒刷新一次
MONITOR_POOL_CACHE_SECONDS=60


# 【可选配置】卖出 LLM 判「持有」后冷却时间 (单位：秒)
# 设置说明：冷却期内不重复咨询 LLM，避免持续卖出信号每 15s 阻塞调 LLM；
#   冷却到期后携最新行情重新复核，行情恶化也能在最多冷却时长内被再次判断。
#   （绝对止损为硬护栏，不过 LLM、不受冷却影响）(默认：1800，即 30 分钟)
LLM_SELL_HOLD_COOLDOWN_SECONDS=1800

# 【可选配置】每轮监控周期最多同步 LLM 买入确认次数
# 设置说明：B方案买入 LLM 确认是同步调用(20-60s)，会阻塞 15s 主循环；
#   预算用尽后其余买入候选留待下轮评估，避免绝对止损等卖出监控被买入 LLM 拖后（默认：1）
LLM_BUY_CONFIRM_PER_CYCLE=1

# 【可选配置】逼近封板区间比例
# 设置说明：逼近封板 = 涨停线 × 此比值（如 9.5×0.84≈8.0），默认 0.84
MONITOR_NEAR_LIMIT_RATIO=0.84

# 【可选配置】盘中信号检测阈值
# 设置说明：逼近封板信号量比下限(5.0)；低开猛拉/振幅放量信号量比下限(3.0)；
#   拉升强度下限(0.8)；低开判定=开盘/昨收<此折扣(0.98)；振幅下限(7%)；
#   振幅信号涨幅下限(3%)；炸板预警：当前涨幅<此值视为炸板(7%)、量比下限(2.0)；
#   MA5 获取失败兜底=现价×此比例(0.97)
NEAR_LIMIT_VOL_RATIO=5.0
RALLY_VOL_RATIO=3.0
RALLY_STRENGTH_MIN=0.8
LOW_OPEN_DEV=0.98
AMPLITUDE_SIGNAL_MIN=7.0
AMPLITUDE_CHANGE_MIN=3.0
ZHABAN_ALERT_CHANGE=7.0
ZHABAN_ALERT_VOL_RATIO=2.0
MA5_FALLBACK_RATIO=0.97
REC_FADE_MAX=2.0
PATTERN_CHECK_MIN_AMOUNT=5.0
PATTERN_CHECK_CACHE_SECONDS=300

# 【可选配置】AI 自动买卖模型
# 设置说明：同板块 AI 持仓上限(2)；买入滑点(0.3%，高位信号+0.2%)；卖出滑点(0.3%)
MAX_AI_SECTOR_POSITIONS=2
AI_BUY_SLIPPAGE_PCT=0.3
AI_BUY_SLIPPAGE_HOT_PCT=0.2
AI_SELL_SLIPPAGE_PCT=0.3

MONITOR_INTERVAL_SECONDS=15

# 【核心参数】主力资金扫货绝对底线 (单位：万元)
# 设置说明：小盘股(流通市值<250亿)的主力净流入兜底阈值，低于此值不触发预警 (默认：2000.0，即 2000 万元)
FUND_INFLOW_MIN=2000.0

# 【核心参数】主力资金扫货流通市值比例
# 设置说明：有效阈值 = max(FUND_INFLOW_MIN, 流通市值 × FUND_INFLOW_CAP_RATIO)。
#   默认 0.0005 时各市值档阈值约为：
#     50亿→2000万 | 100亿→2000万(兜底) | 500亿→2500万 | 1000亿→5000万 | 2000亿→1亿
#   小盘看绝对量、大盘看相对量，避免一刀切 (默认：0.0005)
FUND_INFLOW_CAP_RATIO=0.0005

# 【核心参数】点火异动 - 成交量放大倍数门槛
# 设置说明：当某股票量比（或成交量相比过去5日均值）达到该倍数时，触发点火预警 (默认：3.0，即放大3倍)
VOL_BURST_THRESHOLD=3.0

# 【核心参数】点火异动 - 股价单次突增涨幅门槛 (%)
# 设置说明：当股价瞬间突增涨幅达到该百分比时，触发点火预警 (默认：3.0，即上涨 3%)
PRICE_BURST_THRESHOLD=3.0

# 【核心参数】点火异动 - 股价涨幅上限 (%) - 主板 10cm
# 设置说明：主板股票涨幅超过该值视为已涨停或接近涨停，不再触发点火信号 (默认：9.5%)
PRICE_BURST_MAX=9.5

# 【核心参数】点火异动 - 股价涨幅上限 (%) - 双创 20cm
# 设置说明：创业板/科创板股票涨幅超过该值视为已涨停或接近涨停，不再触发点火信号 (默认：19.5%)
PRICE_BURST_MAX_20CM=19.5

# 【核心参数】主板/双创涨停线涨幅 (%) - 用于"是否涨停/跌停"判定
# 设置说明：主板达到 9.8% 视为涨停，创业板/科创板达到 19.8% 视为涨停（默认：9.8 / 19.8）
MAIN_BOARD_LIMIT_PCT=9.8
GEM_STAR_LIMIT_PCT=19.8

# 【可选配置】AkShare 数据抓取失败时的最大重试次数
# 设置说明：防止网络波动导致数据异常 (默认：3 次)
FETCH_RETRY_COUNT=3

# 【可选配置】数据源当日熔断阈值
# 设置说明：某数据源当日异常达此次数后，当天剩余时间不再调用该源（次日自动重置）。
#   例如东财 spot 连接不稳定时，失败3次后自动改走腾讯，避免每15秒空等。默认：3
SOURCE_FAIL_CIRCUIT_LIMIT=3

# 【可选配置】涨停/炸板池刷新失败后的退避重试间隔（秒）
# 设置说明：东财接口异常时，涨停/炸板池不再每60秒轮询，改为退避 N 秒后再试（避免反爬压力）。默认 300（5分钟）
POOL_CACHE_FAIL_BACKOFF_SECONDS=300

# 【可选配置】AkShare 数据抓取重试延迟 (单位：秒)
# 设置说明：每次重试之间的间隔秒数 (默认：2.0 秒)
FETCH_RETRY_DELAY=2.0


# ------------------------------------------------------------------------------
# 4. 股票过滤配置 (源头剔除科创板、北交所及 ST 股)
# ------------------------------------------------------------------------------

# 【推荐开启】是否排除科创板股票 (代码 688 开头)
# 设置说明：true = 剔除科创板；false = 保留科创板 (默认：true)
EXCLUDE_STAR_MARKET=true

# 【推荐开启】是否排除北交所股票 (代码 8开头/43/83/87/920 等)
# 设置说明：true = 剔除北交所；false = 保留北交所 (默认：true)
EXCLUDE_BSE=true

# 【推荐开启】是否排除 ST 及 *ST 风险警示股票
# 设置说明：true = 剔除所有带有 ST 标识的股票；false = 保留 ST 股 (默认：true)
EXCLUDE_ST=true


# ------------------------------------------------------------------------------
# 5. 交易所异常波动监管红线与异动胆量风控配置
# ------------------------------------------------------------------------------

# 【推荐开启】交易所监管异动监控总开关
# 设置说明：true = 自动计算 3日偏离度、10日严重异动及资金突破胆量；false = 关闭监管监控 (默认：true)
REGULATORY_MONITOR_ENABLED=true

# 【官方规则】主板 3 日累计偏离度异动红线 (%)
# 设置说明：主板股票 3 个交易日内涨幅偏离度达到该值时，官方发布《异动公告》(默认：20.0%)
MAIN_BOARD_3D_DEV_LIMIT=20.0

# 【官方规则】创业板 3 日累计偏离度异动红线 (%)
# 设置说明：创业板股票 3 个交易日内涨幅偏离度达到该值时，官方发布《异动公告》(默认：30.0%)
GEM_3D_DEV_LIMIT=30.0

# 【官方规则】科创板 3 日累计偏离度异动红线 (%)
# 设置说明：科创板与创业板同为 20cm 涨停机制，偏离度红线相同 (默认：30.0%)
STAR_3D_DEV_LIMIT=30.0

# 【官方规则】10 日严重异常波动累计偏离度红线 (%)
# 设置说明：连续 10 个交易日偏离度达到该值，触发《严重异常波动》及停牌风险 (默认：100.0%)
REGULATORY_10D_LIMIT=100.0

# 【官方规则】10 日内触发异动次数上限
# 设置说明：连续 10 个交易日内触发异常波动的次数达到该值，直接触发严重异动 (默认：4 次)
MAX_YIDONG_COUNT_10D=4


# ------------------------------------------------------------------------------
# 6. 仓位管理与熔断配置 (AI 自动交易风控)
# ------------------------------------------------------------------------------

# 【风险控制】AI 自动持仓最大数量
# 设置说明：AI 策略同时持有的最大标的数，超出则不再开新仓 (默认：5)
MAX_AI_POSITIONS=5

# 【风险控制】AI 每日最大自动买入次数
# 设置说明：限制 AI 每个交易日最多自动买入多少笔 (默认：3)
MAX_DAILY_BUYS=3

# 【熔断机制】AI 持仓当日平均亏损熔断阈值 (%)
# 设置说明：AI 持仓当日平均收益率低于该百分比时，触发熔断停止买入 (默认：-5.0%)
DAILY_LOSS_CIRCUIT_BREAKER=-5.0

# 【熔断机制】大盘跌幅系统级熔断阈值 (%)
# 设置说明：大盘均涨幅跌破此值时触发系统级熔断，停止所有自动买入操作 (默认：-2.0%)
INDEX_DROP_CIRCUIT_BREAKER=-2.0


# ------------------------------------------------------------------------------
# 7. 止损止盈配置
# ------------------------------------------------------------------------------

# 【强制风控】绝对止损线 (%)
# 设置说明：单只持仓浮亏超过此百分比，无条件触发卖出指令 (默认：-7.0%)
ABSOLUTE_STOP_LOSS_PCT=-7.0

# 【时间风控】时间止损天数
# 设置说明：持仓超过 N 个交易日仍未盈利(浮亏或持平)，触发止损警告 (默认：3 天)
TIME_STOP_LOSS_DAYS=3

# 【止盈提醒】止盈提醒线 (%)
# 设置说明：持仓浮盈超过此百分比，触发止盈 WARNING 级别提醒 (默认：15.0%)
TAKE_PROFIT_WARN_PCT=15.0

# 【强止盈线】强止盈线 (%)
# 设置说明：持仓浮盈超过此百分比且从高点有所回落时，触发 CRITICAL 级别强止盈信号 (默认：20.0%)
TAKE_PROFIT_CRITICAL_PCT=20.0


# ------------------------------------------------------------------------------
# 8. 情绪到顶与退潮预警阈值
# ------------------------------------------------------------------------------

# 【情绪到顶】全市场连板高度触发预警的最低板数
# 设置说明：当全市场最高连板数达到该值时，判定短线情绪进入极度亢奋区，触发退潮预警 (默认：8 板)
EMOTION_TOP_MAX_LBC=8

# 【情绪到顶】全市场炸板率触发预警阈值 (%)——顶部裂纹信号
# 设置说明：全市场炸板率超过该百分比时，判定封板质量恶化，短线情绪可能加速退潮 (默认：35.0%)
EMOTION_TOP_ZHABAN_RATE=35.0

# 【情绪到顶】触发预警要求的最低情绪分（顶部时情绪仍热，而非崩溃后；默认 75）
# 设置说明：连板极高 + 情绪仍热 + 炸板率异常 三者同时满足才预警——在顶部裂纹出现时提醒，而非等情绪崩了才提示
EMOTION_TOP_SENTIMENT_MIN=75.0


# ------------------------------------------------------------------------------
# 9. 板块联动监控配置
# ------------------------------------------------------------------------------

# 【板块联动】板块涨停家数联动预警阈值
# 设置说明：同一板块内涨停家数达到此值时，触发板块联动预警 (默认：3 家)
SECTOR_LINKAGE_MIN_COUNT=3

# 【板块联动】板块涨停加速预警阈值
# 设置说明：板块涨停家数较上一轮监控周期增加此值时，触发加速预警 (默认：2 家)
SECTOR_LINKAGE_ACCEL_DELTA=2

# 【板块联动】板块联动预警推送开关
# 设置说明：false 时仍记录日志/数据，但不再推送到 Bark（避免刷屏被频率限制）(默认：true)
SECTOR_LINKAGE_PUSH_ENABLED=true


# 9.5. 概念主线识别配置（切片3）
# 【概念】概念成分股映射刷新间隔（天）
# 设置说明：成分股变化慢，可调大省请求（新浪约 175 次/刷新）(默认：1 天)
CONCEPT_MEMBER_REFRESH_INTERVAL_DAYS=1

# 【概念】概念主线分阈值
# 设置说明：≥此值判为主线概念（与板块一致）(默认：0.5)
CONCEPT_MAINLINE_SCORE_THRESHOLD=0.5

# 【概念】盘中概念因子否决开关
# 设置说明：false 关闭后概念不参与买入闸门（板块因子仍生效）。若发现过度否决可关 (默认：true)
CONCEPT_GATE_ENABLED=true


# ------------------------------------------------------------------------------
# 10. 量化战法与核心中军池参数配置
# ------------------------------------------------------------------------------

# 【动态中军】板块内选取的成交额 Top N 排名门槛
# 设置说明：筛选板块内成交额前 N 名的标的作为中军候选 (默认：前 3 名)
CORE_POOL_TOP_AMOUNT=3

# 【动态中军】板块内选取的总市值 Top N 排名门槛
# 设置说明：筛选板块内总市值前 N 名的标的作为中军候选 (默认：前 5 名)
CORE_POOL_TOP_MARKET_CAP=5

# 【动态中军】中军走势与板块指数皮尔逊相关系数 (Correlation/Beta) 门槛
# 设置说明：范围 0.0 ~ 1.0。值越大代表股票走势与板块指数越同频，低于该值被剔除 (默认：0.8)
CORE_POOL_MIN_BETA=0.8

# 【动态中军】中军日成交额最低门槛 (单位：亿元)
# 设置说明：中军必须是大容量流动性标的，日成交额不得低于该值 (默认：12.0 亿元)
CORE_POOL_MIN_AMOUNT=12.0

# 【二波战法】人气总龙头见顶后回撤最小比例
# 设置说明：前期人气龙头从最高点回撤达到该比例后开始关注二波止跌信号 (默认：0.30，即回撤 30%)
SECOND_WAVE_RETREAT_MIN=0.30

# 【二波战法】人气总龙头见顶后回撤最大比例
# 设置说明：回撤超过该比例说明题材彻底杀跌死掉，不再做二波 (默认：0.50，即回撤 50%)
SECOND_WAVE_RETREAT_MAX=0.50

# 【二波战法】追溯历史人气龙头的天数
# 设置说明：寻找过去多少个交易日内出现的连板总龙头 (默认：30 个交易日)
SECOND_WAVE_LOOKBACK_DAYS=30


# ------------------------------------------------------------------------------
# 11. 动态阈值与情绪权重配置 (高级参数，一般无需修改)
# ------------------------------------------------------------------------------

# 【容量因子】流动性枯竭判定下限
# 设置说明：容量因子 K 低于此值判定为流动性枯竭环境，策略将趋于保守 (默认：0.7)
CAPACITY_K_MIN=0.7

# 【容量因子】流动性泛滥判定上限
# 设置说明：容量因子 K 高于此值判定为流动性泛滥环境，可适当积极操作 (默认：1.5)
CAPACITY_K_MAX=1.5

# 【溢价崩塌】抱团避险触发阈值 (%)
# 设置说明：溢价指标跌破此值时，判定短线情绪进入恐慌状态，触发抱团避险信号 (默认：-2.5%)
PREMIUM_PANIC_THRESHOLD=-2.5

# 【盘中情绪分权重 - 溢价】溢价维度在盘中实时情绪评分中的权重 (默认：0.36)
PREMIUM_WEIGHT=0.36

# 【盘中情绪分权重 - 宽度】市场宽度维度在盘中实时情绪评分中的权重 (默认：0.29)
BREADTH_WEIGHT=0.29

# 【盘中情绪分权重 - 高度】连板高度维度在盘中实时情绪评分中的权重 (默认：0.21)
HEIGHT_WEIGHT=0.21

# 【盘中情绪分权重 - 承接】资金承接维度在盘中实时情绪评分中的权重 (默认：0.14)
SUPPORT_WEIGHT=0.14


# ------------------------------------------------------------------------------
# 11.5 龙虎榜席位画像配置
# ------------------------------------------------------------------------------

# 【可选配置】席位自动分类所需最低上榜次数
# 设置说明：上榜次数不足此值判"未知"，够样本才按行为定型 (默认：3)
SEAT_CLASSIFY_MIN_SAMPLES=3

# 【可选配置】平均单只买入金额阈值 (单位：万元)
# 设置说明：平均单只买入金额低于此值视为散户/小单倾向（拉萨风格），默认 800 万
SEAT_AVG_BUY_THRESHOLD_WAN=800.0

# 【可选配置】格局派判定：净买入天数占比下限 (默认 0.6，即 60% 天数为净买入)
SEAT_NET_POSITIVE_ZHIGE=0.6

# 【可选配置】砸盘派判定：净买入天数占比上限 (默认 0.3，即低于 30% 视为砸盘倾向)
SEAT_NET_POSITIVE_ZSHA=0.3


# ------------------------------------------------------------------------------
# 12. API Server 安全配置
# ------------------------------------------------------------------------------

# 【可选配置】API Server 鉴权密钥
# 设置说明：启动 API Server 后，客户端请求需要在 Header 中携带 `Authorization: Bearer <此Key>`。
#   - 留空则跳过 API 鉴权，所有请求放行（仅推荐本地调试时使用）
#   - 生产环境请设置一个高强度随机字符串

# 【可选配置】回测/净值计算初始资金 (单位：元)
# 设置说明：回测模拟和每日净值快照的起始资金 (默认：1000000，即 100 万)
BACKTEST_INITIAL_CAPITAL=1000000

# 【可选配置】立案调查黑名单缓存刷新间隔 (单位：秒)
# 设置说明：避免 15 秒轮询时高频查库，默认 3600 秒（1 小时）
INVESTIGATION_CACHE_SECONDS=3600

# 【可选配置】API 服务监听地址
# 设置说明：默认 127.0.0.1（仅本机访问，安全）；如需局域网/远程访问改为 0.0.0.0 并务必设置 API_KEY
API_HOST=127.0.0.1

API_KEY=
